<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Arise.Application\Arise.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Références explicites, et non redondantes : Microsoft.EntityFrameworkCore.Design est
      marqué PrivateAssets=all (outillage de conception, il n'a rien à faire chez les
      consommateurs). Il tire la ligne EF Core 10.0.10, que ce marquage empêche justement de
      transiter. Les projets en aval ne voyaient donc que le 10.0.4 tiré par Npgsql, et ne
      pouvaient plus compiler contre un Arise.Infrastructure bâti sur 10.0.10 (CS1705).

      Les DEUX paquets doivent être épinglés. N'épingler que Microsoft.EntityFrameworkCore
      laissait Relational désaligné : Arise.Infrastructure compilait contre Relational
      10.0.10 pendant que Arise.Api en chargeait la 10.0.4 (MSB3277, « 10.0.4 was chosen
      because it was primary »). Le chargeur .NET résout par nom simple et tolère cette
      rétrogradation sans broncher — l'échec ne serait sorti qu'en MissingMethodException au
      premier AddInfrastructure(), au démarrage de l'API, jamais au build ni en test.

      Vérification : dotnet build ne doit émettre aucun MSB3277. Si un troisième paquet de
      la ligne EF Core entre un jour par ce chemin, c'est le moment de passer la solution en
      Central Package Management plutôt que d'allonger cette liste.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      Porte Microsoft.AspNetCore.Identity.PasswordHasher<T> : le hachage salé autonome voulu
      par CLAUDE.md (pas de fournisseur d'identité externe). Version alignée sur la ligne EF
      Core 10.0.10 du dépôt.
    -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
    <!--
      Signature et écriture des JWT (HS256) par JwtTokenGenerator. Le middleware JwtBearer qui
      les valide vit côté API et tire la même ligne Microsoft.IdentityModel 8.x transitivement.
    -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Les implémentations restent internal ; leurs tests les instancient et vérifient le
         câblage DI par type concret. -->
    <InternalsVisibleTo Include="Arise.Infrastructure.Tests" />
  </ItemGroup>

</Project>
