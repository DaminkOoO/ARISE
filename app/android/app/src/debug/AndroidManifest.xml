<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Le HTTP en clair est bloqué par Android depuis l'API 28. L'API ARISE
         tourne en local sur http://10.0.2.2:5006 (la boucle locale de la
         machine hôte, vue depuis l'émulateur), sans TLS : sans cette
         autorisation, chaque appel échouerait.

         Elle est déclarée ici, et **uniquement** ici : c'est un confort de
         développement local, il ne doit pas suivre l'app en production. Le
         manifeste principal ne la porte pas — voir test/android/manifestes_test.dart,
         qui échoue si elle y apparaît. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
